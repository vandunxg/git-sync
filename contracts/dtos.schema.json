{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GBM v1 app-owned DTO definitions",
  "$comment": "Normative blueprint, not an existing Tauri API or generated SDK. Apply format checking in tests.",
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "Empty": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "Revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Provider": {
      "type": "string",
      "enum": [
        "github",
        "gitlab"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "AUTH_REQUIRED",
        "ACCESS_DENIED",
        "RATE_LIMITED",
        "NETWORK_UNAVAILABLE",
        "TIMEOUT",
        "GIT_UNAVAILABLE",
        "GIT_LFS_UNAVAILABLE",
        "KEYRING_UNAVAILABLE",
        "PATH_REJECTED",
        "ROOT_RELOCATION_UNSUPPORTED",
        "SOURCE_UNAVAILABLE",
        "PARTIAL_DISCOVERY",
        "PLAN_STALE",
        "APPROVAL_REQUIRED",
        "DESTINATION_DIVERGED",
        "PROTECTED_REF",
        "PUSH_PARTIAL",
        "VERIFY_FAILED",
        "DISK_FULL",
        "MIRROR_INVALID",
        "WORKSPACE_SKIPPED",
        "LFS_INCOMPLETE",
        "SUBMODULE_UNCOVERED",
        "CANCEL_UNCERTAIN",
        "CONTRACT_MISMATCH",
        "UNSUPPORTED",
        "INTERNAL"
      ]
    },
    "AppError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "retryable": {
          "type": "boolean"
        },
        "retryAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "correlationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "details": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "retryAt",
        "correlationId",
        "details"
      ],
      "additionalProperties": false
    },
    "AccountSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "authState": {
          "type": "string",
          "enum": [
            "unknown",
            "connected",
            "expired",
            "forbidden",
            "disconnected"
          ]
        },
        "storageMode": {
          "type": "string",
          "enum": [
            "keyring",
            "session_only",
            "none"
          ]
        },
        "expiresAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "capabilitySummary": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "verifiedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "provider",
        "username",
        "authState",
        "storageMode",
        "expiresAt",
        "capabilitySummary",
        "verifiedAt"
      ],
      "additionalProperties": false
    },
    "RootSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "displayPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ownershipVerified": {
          "type": "boolean"
        },
        "availableBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "workspaceEnabled": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "displayPath",
        "ownershipVerified",
        "availableBytes",
        "workspaceEnabled"
      ],
      "additionalProperties": false
    },
    "Coverage": {
      "type": "object",
      "properties": {
        "gitRefs": {
          "type": "string",
          "enum": [
            "not_checked",
            "verified",
            "failed"
          ]
        },
        "localObjects": {
          "type": "string",
          "enum": [
            "not_checked",
            "verified",
            "failed"
          ]
        },
        "lfs": {
          "type": "string",
          "enum": [
            "not_applicable",
            "not_checked",
            "local_verified",
            "uploaded",
            "restore_verified",
            "incomplete"
          ]
        },
        "submodules": {
          "type": "string",
          "enum": [
            "none",
            "pointers_only",
            "separately_covered",
            "incomplete"
          ]
        }
      },
      "required": [
        "gitRefs",
        "localObjects",
        "lfs",
        "submodules"
      ],
      "additionalProperties": false
    },
    "RepositorySummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "providerRepositoryId": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "defaultBranch": {
          "type": [
            "string",
            "null"
          ]
        },
        "isPrivate": {
          "type": "boolean"
        },
        "isFork": {
          "type": "boolean"
        },
        "isArchived": {
          "type": "boolean"
        },
        "selected": {
          "type": "boolean"
        },
        "sourceState": {
          "type": "string",
          "enum": [
            "unknown",
            "current",
            "changed",
            "unavailable",
            "stale"
          ]
        },
        "mirrorState": {
          "type": "string",
          "enum": [
            "missing",
            "staging",
            "current",
            "invalid",
            "unknown"
          ]
        },
        "destinationState": {
          "type": "string",
          "enum": [
            "missing",
            "current",
            "behind",
            "diverged",
            "inaccessible",
            "unknown"
          ]
        },
        "workspaceState": {
          "type": "string",
          "enum": [
            "disabled",
            "current",
            "behind",
            "dirty",
            "ahead",
            "detached",
            "diverged",
            "missing"
          ]
        },
        "primaryStatus": {
          "type": "string",
          "enum": [
            "synced",
            "update",
            "failed",
            "missing",
            "blocked",
            "running",
            "unknown",
            "stale"
          ]
        },
        "pendingRefChanges": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "observedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "verifiedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "lastErrorCode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        }
      },
      "required": [
        "id",
        "providerRepositoryId",
        "fullName",
        "defaultBranch",
        "isPrivate",
        "isFork",
        "isArchived",
        "selected",
        "sourceState",
        "mirrorState",
        "destinationState",
        "workspaceState",
        "primaryStatus",
        "pendingRefChanges",
        "observedAt",
        "verifiedAt",
        "lastErrorCode",
        "coverage"
      ],
      "additionalProperties": false
    },
    "RepoListRequest": {
      "type": "object",
      "properties": {
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "search": {
          "type": "string",
          "maxLength": 256
        },
        "status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "synced",
            "update",
            "failed",
            "missing",
            "blocked",
            "running",
            "unknown",
            "stale",
            null
          ]
        },
        "visibility": {
          "type": "string",
          "enum": [
            "all",
            "private",
            "public"
          ]
        },
        "selectedOnly": {
          "type": "boolean"
        },
        "sort": {
          "type": "string",
          "enum": [
            "name_asc",
            "updated_desc"
          ]
        }
      },
      "required": [
        "cursor",
        "limit",
        "search",
        "status",
        "visibility",
        "selectedOnly",
        "sort"
      ],
      "additionalProperties": false
    },
    "RepoListResult": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RepositorySummary"
          }
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "totalCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "discoveryComplete": {
          "type": "boolean"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "items",
        "nextCursor",
        "totalCount",
        "discoveryComplete",
        "revision"
      ],
      "additionalProperties": false
    },
    "RepoRequest": {
      "type": "object",
      "properties": {
        "repositoryId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "repositoryId"
      ],
      "additionalProperties": false
    },
    "JobRequest": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "jobId"
      ],
      "additionalProperties": false
    },
    "RefEntry": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^refs/(heads|tags)/.+$"
        },
        "oid": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        }
      },
      "required": [
        "name",
        "oid"
      ],
      "additionalProperties": false
    },
    "RefOperation": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "create",
            "fast_forward",
            "rewrite",
            "move_tag",
            "delete_ref"
          ]
        },
        "refName": {
          "type": "string",
          "pattern": "^refs/(heads|tags)/.+$"
        },
        "expectedDestinationOid": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceOid": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "refName",
        "expectedDestinationOid",
        "sourceOid"
      ],
      "additionalProperties": false
    },
    "SyncPlan": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "repositoryId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "sourceSnapshotId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "sourceDigest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "destinationMappingId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "destinationDigest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "policyRevision": {
          "$ref": "#/$defs/Revision"
        },
        "planDigest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RefOperation"
          }
        },
        "requiresApproval": {
          "type": "boolean"
        },
        "preChangeSnapshotRequired": {
          "type": "boolean"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "repositoryId",
        "sourceSnapshotId",
        "sourceDigest",
        "destinationMappingId",
        "destinationDigest",
        "policyRevision",
        "planDigest",
        "operations",
        "requiresApproval",
        "preChangeSnapshotRequired",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "PlanRequest": {
      "type": "object",
      "properties": {
        "repositoryId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "repositoryId"
      ],
      "additionalProperties": false
    },
    "PlanApprovalRequest": {
      "type": "object",
      "properties": {
        "planId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "expectedPlanDigest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "expectedPolicyRevision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "planId",
        "expectedPlanDigest",
        "expectedPolicyRevision"
      ],
      "additionalProperties": false
    },
    "ApplyRequest": {
      "type": "object",
      "properties": {
        "planId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "approvalId": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "planId",
        "approvalId"
      ],
      "additionalProperties": false
    },
    "QueuedResult": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "queued"
          ]
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "jobId",
        "state",
        "revision"
      ],
      "additionalProperties": false
    },
    "Job": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "repositoryId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "waiting_for_approval",
            "waiting_for_retry",
            "cancel_requested",
            "succeeded",
            "partial",
            "failed",
            "canceled",
            "interrupted"
          ]
        },
        "stage": {
          "type": "string",
          "enum": [
            "preflight",
            "observe_source",
            "fetch",
            "plan",
            "snapshot",
            "transfer_lfs",
            "push",
            "verify",
            "workspace",
            "finalize"
          ]
        },
        "progressPercent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "transferredBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "totalBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "etaSeconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/AppError"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "accountId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "planId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "scan",
            "plan",
            "sync",
            "restore_test"
          ]
        }
      },
      "required": [
        "id",
        "repositoryId",
        "attempt",
        "state",
        "stage",
        "progressPercent",
        "transferredBytes",
        "totalBytes",
        "etaSeconds",
        "error",
        "coverage",
        "revision",
        "accountId",
        "planId",
        "kind"
      ],
      "additionalProperties": false
    },
    "AccountList": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AccountSummary"
          }
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "items",
        "revision"
      ],
      "additionalProperties": false
    },
    "CredentialRequest": {
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/$defs/Provider"
        },
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "writeOnly": true,
          "$comment": "Secret input only. Never log, echo, fixture or persist outside keyring."
        },
        "storageMode": {
          "type": "string",
          "enum": [
            "keyring",
            "session_only"
          ]
        }
      },
      "required": [
        "provider",
        "token",
        "storageMode"
      ],
      "additionalProperties": false
    },
    "AccountRequest": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "accountId"
      ],
      "additionalProperties": false
    },
    "AccountResult": {
      "type": "object",
      "properties": {
        "account": {
          "$ref": "#/$defs/AccountSummary"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "account",
        "revision"
      ],
      "additionalProperties": false
    },
    "Ack": {
      "type": "object",
      "properties": {
        "revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "revision"
      ],
      "additionalProperties": false
    },
    "ApprovalResult": {
      "type": "object",
      "properties": {
        "approvalId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "planId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "approvalId",
        "planId",
        "expiresAt",
        "revision"
      ],
      "additionalProperties": false
    },
    "StorageCandidate": {
      "type": "object",
      "properties": {
        "candidateId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "displayPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "valid": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AppError"
          }
        }
      },
      "required": [
        "candidateId",
        "displayPath",
        "valid",
        "errors"
      ],
      "additionalProperties": false
    },
    "RootCommitRequest": {
      "type": "object",
      "properties": {
        "candidateId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "workspaceEnabled": {
          "type": "boolean"
        }
      },
      "required": [
        "candidateId",
        "workspaceEnabled"
      ],
      "additionalProperties": false
    },
    "SelectionRequest": {
      "type": "object",
      "properties": {
        "repositoryIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "maxItems": 200
        },
        "selected": {
          "type": "boolean"
        },
        "expectedRevision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "repositoryIds",
        "selected",
        "expectedRevision"
      ],
      "additionalProperties": false
    },
    "ScanRequest": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "reconcileRefs": {
          "type": "boolean"
        }
      },
